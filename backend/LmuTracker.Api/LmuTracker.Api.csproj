<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\LmuTracker.Infrastructure\LmuTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\LmuTracker.Application\LmuTracker.Application.csproj" />
    <ProjectReference Include="..\LmuTracker.Domain\LmuTracker.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.152.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fonte dos cards Open Graph (Saira Condensed, SIL Open Font License — ver Og/Fonts/OFL.txt). -->
    <EmbeddedResource Include="Og/Fonts/*.ttf" />
  </ItemGroup>

</Project>
