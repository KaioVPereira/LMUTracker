# Build do scanner (LmuTracker.Worker) em duas etapas: o SDK compila, a imagem final leva só o runtime.
# Contexto de build: a pasta backend/.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore LmuTracker.Worker/LmuTracker.Worker.csproj
RUN dotnet publish LmuTracker.Worker/LmuTracker.Worker.csproj \
    -c Release -o /app --no-restore

# ---------- Imagem final (só runtime; o Worker não serve HTTP) ----------
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS final
WORKDIR /app
COPY --from=build /app .

ENV DOTNET_ENVIRONMENT=Production
ENTRYPOINT ["dotnet", "LmuTracker.Worker.dll"]
