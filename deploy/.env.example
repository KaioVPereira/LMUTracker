# Copie para .env (ao lado) e preencha. O .env NUNCA é versionado.

# Conexão com o banco. Reusa o SQL Server do GameTracker: Server=db (nome do serviço na rede do
# GameTracker), banco próprio LmuTracker, usuário sa com a MESMA senha do GameTracker (o DB_PASSWORD
# que está em /root/GameTracker/deploy/.env). O worker cria o banco LmuTracker sozinho no primeiro start.
LMU_DB=Server=db;Database=LmuTracker;User Id=sa;Password=A_MESMA_SENHA_DO_GAMETRACKER;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# Login (account name) da conta de serviço Steam. A SENHA não vai aqui — é digitada só no bootstrap
# interativo `steam-login`, que grava o refresh token no volume steam-session.
STEAM_USERNAME=conta_de_servico
